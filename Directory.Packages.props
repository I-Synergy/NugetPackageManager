<Project>

  <!--
    Central package versions for the C# projects in this repository.

    This file is discovered by every project below the root, which is why the
    `tests/NugetPackageManager.TestUtilities/Fixtures/` tree opts out explicitly: those
    `.csproj` files are test data the extension evaluates at runtime, and they declare their own
    package versions.
  -->
  <PropertyGroup>
    <IsSidecarProject>true</IsSidecarProject>
    <!-- Segment match on both separators, so `Fixtures` is recognised on Windows and Unix. -->
    <IsSidecarProject Condition="$([System.String]::Copy('$(MSBuildProjectFullPath)').Replace('\','/').Contains('/Fixtures/'))">false</IsSidecarProject>
    <ManagePackageVersionsCentrally Condition="'$(IsSidecarProject)' == 'true'">true</ManagePackageVersionsCentrally>
    <ManagePackageVersionsCentrally Condition="'$(IsSidecarProject)' != 'true'">false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsSidecarProject)' == 'true'">
    <!-- NuGet client libraries: the reason this project exists. -->
    <PackageVersion Include="NuGet.Frameworks" Version="8.0.0" />
    <PackageVersion Include="NuGet.Protocol" Version="8.0.0" />
    <PackageVersion Include="NuGet.Versioning" Version="8.0.0" />
    <!-- Security pin: NuGet.Protocol 8.0.0 pulls Pkcs 8.0.1 (NU1902/NU1903); 8.0.2 is the
         patched in-band release (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />

    <!-- Test stack: MSTest is the project standard (.ai/reference/forbidden-tech.md
         forbids xUnit and NUnit); Moq for isolation. -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
  </ItemGroup>

</Project>
