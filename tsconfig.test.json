{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "out",
    "noEmit": false,
    "declaration": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["tests/__fixtures__/**"]
}
