<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NugetPackageManager.Core.NuGet</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NugetPackageManager.Core.NuGet.Tests" />
  </ItemGroup>

  <!-- Versions come from Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="NuGet.Protocol" />
    <!-- Security pin (see Directory.Packages.props): lift the transitive Pkcs 8.0.1 that
         NuGet.Protocol 8.0.0 brings in to the patched 8.0.2. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

</Project>
