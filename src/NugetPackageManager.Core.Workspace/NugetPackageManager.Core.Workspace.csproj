<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NugetPackageManager.Core.Workspace</RootNamespace>
  </PropertyGroup>

  <!--
    The workspace model: project discovery, .csproj/.props reading, CPM resolution and target
    framework evaluation. Kept separate from Core.NuGet so the package-source adapter and the
    project model can evolve (and be tested) independently.
  -->

  <ItemGroup>
    <!-- Dependency semantics: NuGet's own version and framework rules instead of a second
         hand-written implementation. Versions come from Directory.Packages.props. -->
    <PackageReference Include="NuGet.Frameworks" />
    <PackageReference Include="NuGet.Versioning" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NugetPackageManager.Common\NugetPackageManager.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NugetPackageManager.Core.Workspace.Tests" />
  </ItemGroup>

</Project>
