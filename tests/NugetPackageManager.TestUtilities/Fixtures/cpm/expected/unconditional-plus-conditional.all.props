<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Pkg.Shared" Version="9.9.9" />
    <PackageVersion Include="Pkg.UnconditionalOnly" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net10.0'))">
    <PackageVersion Include="Pkg.Shared" Version="9.9.9" />
  </ItemGroup>
</Project>
